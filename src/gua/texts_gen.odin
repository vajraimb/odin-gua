package gua

ZH_FILE :: "../../data/zhouyi.txt"
EN_FILE :: "../../data/legge.txt"
ZH_TEXT :: #load(ZH_FILE, string)
EN_TEXT :: #load(EN_FILE, string)
ZH_FNV64A :: u64(0xd3a98a199fb96bd3)
EN_FNV64A :: u64(0x7a147869501b169b)

// 指纹封印：文本与偏移表必须出自同一版本
#assert(#load_hash(ZH_FILE, "fnv64a") == ZH_FNV64A)
#assert(#load_hash(EN_FILE, "fnv64a") == EN_FNV64A)
#assert(len(ZH_TEXT) == 20482)
#assert(len(EN_TEXT) == 86168)

